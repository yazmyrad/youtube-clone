# `make env` generates backend/.env for the dev stack; use this file only without the Makefile.
# Environment variables override backend/.env. The compose deploy doesn't use it.
DATABASE_URL=postgresql+asyncpg://app:app@127.0.0.1:55432/app
# Only database tests use this; without it they skip. Its database name must end in "test".
TEST_DATABASE_URL=postgresql+asyncpg://app:app@127.0.0.1:55432/app_test
# Signs access tokens: at least 32 random characters; `make env` generates one.
# Left empty on purpose, so the API refuses to start with a published example secret.
JWT_SECRET=
