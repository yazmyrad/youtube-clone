# For running the API outside Docker: cp .env.example .env && uvicorn app.main:app --port 8080
# Environment variables override this file. The compose deploy doesn't use it.
# No Postgres is reachable from the host yet, so /docs works but /api/health returns 503.
DATABASE_URL=postgresql+asyncpg://app:app@127.0.0.1:5432/app
